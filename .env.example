# Local Docker development credentials only. Replace all three in production.
POSTGRES_PASSWORD=local-owner-password
APP_DB_PASSWORD=local-app-password
READ_DB_PASSWORD=local-reader-password
DATABASE_URL=postgresql+psycopg://firstlisten_app:local-app-password@localhost:5432/firstlisten
READ_DATABASE_URL=postgresql+psycopg://firstlisten_reader:local-reader-password@localhost:5432/firstlisten
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:local-owner-password@localhost:5432/firstlisten
TOKEN_TTL_SECONDS=2592000
CHAT_REQUESTS_PER_MINUTE=20
AUTH_REQUESTS_PER_MINUTE=10
QUERY_TIMEOUT_MS=2000
DISPLAY_TIMEZONE=Asia/Seoul

# Optional: enables LLM tool-calling question classification. Empty = regex fallback.
PICKLE_API_KEY=
# Evaluation only (python -m evals.run_eval): CHAT_REQUESTS_PER_MINUTE=200, CHAT_DEBUG=true
CHAT_DEBUG=false
